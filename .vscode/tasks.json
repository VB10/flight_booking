{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Codegen: all",
      "detail": "LocaleKeys + assets/fonts + models + routes",
      "type": "shell",
      "command": "./scripts/generate.sh",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": []
    },
    {
      "label": "Codegen: watch",
      "detail": "build_runner watch (regenerate on save)",
      "type": "shell",
      "command": "./scripts/generate.sh --watch",
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "Codegen: localization only",
      "detail": "Regenerate LocaleKeys after editing a translation JSON",
      "type": "shell",
      "command": "./scripts/generate.sh --localization",
      "problemMatcher": []
    },
    {
      "label": "Codegen: clean build",
      "detail": "Clean generated output, then generate everything",
      "type": "shell",
      "command": "./scripts/generate.sh --clean",
      "problemMatcher": []
    },
    {
      "label": "Backend: free port",
      "detail": "Kill whatever still listens on 8080 (old server) before a new one starts",
      "type": "shell",
      "command": "./start_backend.sh 8080 --free-only",
      "presentation": {
        "reveal": "silent",
        "panel": "shared"
      },
      "problemMatcher": []
    },
    {
      "label": "Backend: start",
      "detail": "Free port 8080, then run the Dart backend in a terminal",
      "type": "shell",
      "command": "./start_backend.sh 8080",
      "isBackground": true,
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      },
      "problemMatcher": {
        "owner": "dart-backend",
        "pattern": {
          "regexp": "^__never_matches__$"
        },
        "background": {
          "activeBegins": true,
          "beginsPattern": "Backend Server'ı başlatılıyor",
          "endsPattern": "Server started on"
        }
      }
    }
  ]
}
